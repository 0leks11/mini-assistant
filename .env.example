# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Google Gemini (get from https://aistudio.google.com/apikey)
# Current prototype uses an API key; account OAuth is not implemented.
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI Realtime (only with assistant.provider = "openai")
# OPENAI_API_KEY=your_openai_project_key_here

# Spotify Connect pairing is done from the Spotify app on the same LAN.

# Home Assistant (Settings → Profile → Long-lived access tokens)
HA_URL=http://192.168.77.2:8123
HA_TOKEN=your_long_lived_token_here

# Private locally enrolled keyword reference. Missing/invalid => manual activation only.
# MINI_WAKEWORD_MODEL=/bkupgrade/data/opt/mini-assistant/keyword.rpw
# Speech activity threshold AFTER activation; not a wake word detector.
# MINI_VAD_THRESHOLD=10
# MINI_SILENCE_TIMEOUT_MS=1000

# Mini SSH
MINI_HOST=192.168.77.110
MINI_PORT=2222
MINI_SSH_KEY=~/.ssh/your_key_name
