# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Google Gemini (get from https://aistudio.google.com/apikey)
# Or use OAuth flow (preferred - see AGENTS.md)
GEMINI_API_KEY=your_gemini_api_key_here

# Spotify (will switch to OAuth PKCE in future)
SPOTIFY_USERNAME=your_spotify_username
SPOTIFY_PASSWORD=your_spotify_password

# Home Assistant (Settings → Profile → Long-lived access tokens)
HA_URL=http://192.168.77.2:8123
HA_TOKEN=your_long_lived_token_here

# Porcupine Wake Word (https://console.picovoice.ai/ - free tier)
PORCUPINE_ACCESS_KEY=your_porcupine_key_here

# Mini SSH
MINI_HOST=192.168.77.110
MINI_PORT=2222
MINI_SSH_KEY=~/.ssh/your_key_name
